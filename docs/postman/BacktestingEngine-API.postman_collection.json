          "name": "Delete Backtest",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/backtest/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "backtest", "{{job_id}}"]
            },
            "description": "Delete a backtest job and its results"
          },
          "response": []
        }
      ]
    },
