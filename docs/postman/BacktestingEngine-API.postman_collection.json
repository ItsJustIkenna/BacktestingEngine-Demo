    {
      "name": "Backtest Jobs",
      "item": [
        {
          "name": "Submit Backtest (Genetic Optimization)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"job_id\", jsonData.job_id);",
                  "    pm.test(\"Job ID is set\", function() {",
                  "        pm.expect(jsonData.job_id).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"BTC/USDT\",\n  \"exchange\": \"kraken\",\n  \"strategy\": \"arbitrage\",\n  \"initial_capital\": 100000.0,\n  \"optimization_method\": \"genetic\",\n  \"population_size\": 50,\n  \"generations\": 20,\n  \"commission_rate\": 0.001,\n  \"fee_rate\": 0.001,\n  \"start_date\": \"2024-01-01\",\n  \"end_date\": \"2024-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/backtest",
              "host": ["{{base_url}}"],
              "path": ["api", "backtest"]
            },
            "description": "Submit a new backtest job with genetic algorithm optimization"
          },
          "response": []
        },
        {
          "name": "Submit Backtest (Manual Parameters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"job_id\", jsonData.job_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"ETH/USDT\",\n  \"exchange\": \"kraken\",\n  \"strategy\": \"arbitrage\",\n  \"initial_capital\": 50000.0,\n  \"optimization_method\": \"manual\",\n  \"risk_aversion\": 0.5,\n  \"inventory_target\": 0.5,\n  \"order_size\": 0.01,\n  \"commission_rate\": 0.002,\n  \"fee_rate\": 0.002,\n  \"start_date\": \"2024-06-01\",\n  \"end_date\": \"2024-11-30\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/backtest",
              "host": ["{{base_url}}"],
              "path": ["api", "backtest"]
            },
            "description": "Submit a backtest with manually specified parameters"
          },
          "response": []
        },
        {
          "name": "Submit Backtest (Grid Search)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"job_id\", jsonData.job_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"SOL/USDT\",\n  \"exchange\": \"kraken\",\n  \"strategy\": \"arbitrage\",\n  \"initial_capital\": 25000.0,\n  \"optimization_method\": \"grid_search\",\n  \"commission_rate\": 0.001,\n  \"fee_rate\": 0.001\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/backtest",
              "host": ["{{base_url}}"],
              "path": ["api", "backtest"]
            },
            "description": "Submit a backtest using grid search optimization"
          },
          "response": []
        },
        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/backtest/{{job_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "backtest", "{{job_id}}", "status"]
